{
  "name": "safire",
  "version": "1.4.1",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "description": "Safire - a privacy-focused, local-first Markdown knowledge forge for Windows.",
  "author": "Safire",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kcmrshll9-ux/Safire.git"
  },
  "bugs": {
    "url": "https://github.com/kcmrshll9-ux/Safire/issues"
  },
  "homepage": "https://github.com/kcmrshll9-ux/Safire#readme",
  "keywords": [
    "electron",
    "knowledge-graph",
    "local-first",
    "markdown",
    "notes",
    "personal-knowledge-management",
    "wikilinks",
    "windows"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "check": "npm run typecheck && npm test && npm run build",
    "start": "node server.mjs",
    "mcp": "node safire-mcp.mjs",
    "mcp:memory": "node safire-memory-mcp.mjs",
    "desktop": "electron .",
    "dist:win": "npm run build && electron-builder --win portable --x64",
    "preview": "node server.mjs",
    "dist:installer": "npm run build && electron-builder --win nsis --x64",
    "dist:all": "npm run build && electron-builder --win nsis portable --x64"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dompurify": "^3.4.12",
    "express": "^5.2.1",
    "undici": "^8.7.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "marked": "^18.0.5",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^6.0.3",
    "vite": "^8.1.3"
  },
  "build": {
    "appId": "com.safire.notes",
    "productName": "Safire",
    "asar": true,
    "asarUnpack": [
      "safire-memory-mcp.mjs",
      "lib/memory/**/*",
      "vault-config.cjs",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "safire-memory-mcp.cmd",
        "to": "safire-memory-mcp.cmd"
      },
      {
        "from": "docs/memory",
        "to": "memory-docs"
      }
    ],
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server.mjs",
      "safire-mcp.mjs",
      "lib/graph-policy.mjs",
      "lib/note-mutations.mjs",
      "lib/note-projection.mjs",
      "lib/notes-mcp-service.mjs",
      "safire-memory-mcp.mjs",
      "safire-memory-mcp.cmd",
      "lib/memory/**/*",
      "vault-config.cjs",
      "package.json",
      "public/app-icon.ico",
      "public/icon.svg",
      "docs/Safire User Guide.html",
      "docs/memory/**/*",
      "LICENSE",
      "PRIVACY.md",
      "THIRD_PARTY_NOTICES.md",
      "TRADEMARKS.md"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "icon": "public/app-icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "Safire Portable ${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Safire",
      "artifactName": "Safire Setup ${version}.${ext}",
      "deleteAppDataOnUninstall": false
    }
  }
}
